.draftline-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(238, 241, 245);
    -unity-font: resource('DraftlineFont');
    -unity-font-style: normal;
}
.setup-screen, .result-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(9, 13, 21, 0.83);
}
.setup-panel, .result-panel {
    width: 580px;
    padding-top: 24px;
    padding-bottom: 22px;
    padding-left: 48px;
    padding-right: 48px;
    background-color: rgb(23, 30, 43);
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(71, 83, 105);
    border-left-color: rgb(71, 83, 105);
    border-right-color: rgb(71, 83, 105);
    border-bottom-color: rgb(71, 83, 105);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}
.brand-large {
    font-size: 47px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: rgb(248, 208, 126);
    margin-bottom: 5px;
}
.subtitle {
    font-size: 17px;
    color: rgb(185, 194, 211);
    margin-bottom: 14px;
}
.section-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(229, 235, 246);
    margin-top: 15px;
    margin-bottom: 9px;
}
.small-copy, .setup-footer {
    font-size: 14px;
    color: rgb(151, 164, 183);
    white-space: normal;
}
.setup-footer { margin-top: 22px; }
.room-options {
    padding-top: 7px;
    padding-bottom: 6px;
}
.seat-options {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}
.seat-button {
    width: 31%;
    height: 31px;
    background-color: rgb(45, 59, 80);
    color: rgb(223, 233, 245);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}
.room-address {
    margin-bottom: 9px;
    color: rgb(217, 229, 244);
}
.room-status {
    min-height: 18px;
    font-size: 12px;
    color: rgb(164, 187, 217);
}
.choice-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 18px;
}
.choice-card {
    width: 48%;
    height: 74px;
    margin-bottom: 12px;
    padding-left: 17px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(31, 40, 55);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 4px;
    border-top-color: rgb(61, 75, 96);
    border-right-color: rgb(61, 75, 96);
    border-bottom-color: rgb(61, 75, 96);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}
.choice-red { border-left-color: rgb(240, 73, 72); }
.choice-blue { border-left-color: rgb(74, 133, 240); }
.choice-green { border-left-color: rgb(71, 199, 106); }
.choice-yellow { border-left-color: rgb(241, 192, 66); }
.choice-toggle { margin-right: 15px; }
.choice-copy { flex-grow: 1; }
.choice-name {
    font-size: 17px;
    -unity-font-style: bold;
}
.choice-corner {
    font-size: 11px;
    color: rgb(145, 160, 181);
    margin-top: 3px;
}
.error-text {
    color: rgb(255, 117, 111);
    font-size: 13px;
    min-height: 22px;
    margin-top: 5px;
}
.primary-button, .action-button, .direction-button, .camera-button {
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(245, 247, 251);
}
.primary-button {
    height: 54px;
    font-size: 17px;
    background-color: rgb(57, 115, 215);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    margin-top: 15px;
}
.primary-button:hover { background-color: rgb(75, 137, 237); }
.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.header {
    height: 64px;
    margin-left: 20px;
    margin-right: 20px;
    margin-top: 14px;
    padding-left: 23px;
    padding-right: 16px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(16, 22, 32, 0.94);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}
.header-brand { flex-grow: 1; }
.brand-small {
    font-size: 23px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(248, 208, 126);
}
.header-caption {
    font-size: 10px;
    letter-spacing: 2px;
    color: rgb(137, 155, 183);
}
.phase-pill {
    min-width: 105px;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 8px;
    padding-bottom: 8px;
    color: rgb(185, 212, 251);
    background-color: rgb(34, 57, 88);
    -unity-text-align: middle-center;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    font-size: 13px;
}
.camera-button {
    width: 118px;
    height: 35px;
    margin-left: 15px;
    font-size: 13px;
    background-color: rgb(48, 58, 74);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}
.camera-button:hover { background-color: rgb(72, 87, 108); }
.side-panel {
    position: absolute;
    top: 92px;
    left: 20px;
    bottom: 19px;
    width: 332px;
    padding-top: 21px;
    padding-left: 21px;
    padding-right: 21px;
    padding-bottom: 17px;
    background-color: rgba(17, 23, 34, 0.94);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}
.overline {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgb(141, 159, 182);
    -unity-font-style: bold;
}
.turn-title {
    font-size: 31px;
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 8px;
}
.rolling-label {
    color: rgb(247, 204, 116);
    font-size: 13px;
    min-height: 19px;
}
.dice-row {
    flex-direction: row;
    align-items: center;
    height: 82px;
    margin-top: 5px;
    margin-bottom: 13px;
}
.dice-value {
    width: 69px;
    height: 69px;
    background-color: rgb(35, 49, 69);
    color: rgb(247, 208, 130);
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
}
.dice-info {
    margin-left: 15px;
}
.stat-label {
    color: rgb(142, 159, 183);
    font-size: 12px;
    margin-bottom: 5px;
}
.remaining-value {
    color: rgb(235, 241, 248);
    font-size: 15px;
    -unity-font-style: bold;
}
.hint-text {
    min-height: 46px;
    padding-top: 11px;
    color: rgb(158, 179, 207);
    font-size: 13px;
    white-space: normal;
}
.actions { min-height: 46px; }
.action-button {
    height: 40px;
    margin-bottom: 7px;
    background-color: rgb(42, 56, 76);
    font-size: 13px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}
.action-button:hover { background-color: rgb(66, 85, 112); }
.action-button:disabled { opacity: 0.35; }
.dir-pad {
    align-items: center;
    margin-top: 4px;
}
.dir-row {
    flex-direction: row;
    justify-content: center;
}
.dir-gap { width: 70px; }
.direction-button {
    width: 64px;
    height: 44px;
    margin-bottom: 6px;
    background-color: rgb(39, 99, 73);
    font-size: 19px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
.direction-button:hover { background-color: rgb(54, 138, 99); }
.direction-button:disabled {
    opacity: 0.3;
    background-color: rgb(42, 56, 76);
}
.selected-label, .waiting-text {
    font-size: 14px;
    margin-bottom: 10px;
    color: rgb(201, 224, 245);
}
.player-list { flex-shrink: 0; }
.player-row {
    min-height: 46px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
    padding-left: 9px;
    padding-right: 7px;
    background-color: rgb(28, 37, 50);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}
.player-current { background-color: rgb(46, 60, 80); }
.player-dot {
    width: 12px;
    height: 12px;
    margin-right: 9px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}
.player-name {
    font-size: 12px;
    -unity-font-style: bold;
    min-width: 54px;
}
.player-stats {
    font-size: 10px;
    color: rgb(164, 177, 198);
    flex-grow: 1;
    -unity-text-align: middle-right;
}
.event-scroll {
    flex-grow: 1;
    min-height: 46px;
    background-color: rgb(20, 28, 40);
    padding-top: 6px;
    padding-left: 8px;
}
.event-entry {
    font-size: 11px;
    color: rgb(173, 190, 211);
    white-space: normal;
    margin-bottom: 5px;
}
.control-note {
    font-size: 10px;
    color: rgb(122, 143, 167);
    margin-top: 14px;
}
.result-panel { align-items: center; }
.result-title {
    margin-top: 15px;
    margin-bottom: 17px;
    font-size: 37px;
    -unity-font-style: bold;
    color: rgb(248, 209, 129);
}
