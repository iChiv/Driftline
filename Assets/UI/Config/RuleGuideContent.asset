--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 50c43620e9e093a4cb1991cdc37cf5b0, type: 3}
  m_Name: RuleGuideContent
  m_EditorClassIdentifier: 
  Steps:
  - Title: "\u6E38\u620F\u8BF4\u660E"
    Body: "\u8BA9\u4E94\u679A\u68CB\u5B50\u8FDE\u6210\u7EBF\uFF0C\u6216\u8005\u6210\u4E3A\u6700\u540E\u5B58\u6D3B\u7684\u4E00\u65B9\u5373\u53EF\u3002"
    Example: "\u25CF  \u25CF  \u25CF  \u25CF  \u25CF\n\n\u6A2A\u3001\u7AD6\u3001\u659C\u5747\u53EF"
  - Title: "\u79FB\u52A8"
    Body: "\u63B7\u9AB0\u540E\u9009\u5B50\uFF0C\u6CBF\u76F4\u7EBF\u6ED1\u5230\u963B\u6321\u524D\u3002\n\n\u9AB0\u5B50\u51B3\u5B9A\u6ED1\u884C\u6B21\u6570\u3002\u56DE\u5408\u5185\u7EE7\u7EED\u79FB\u52A8\u540C\u4E00\u679A\u68CB\u5B50\uFF0C\u76F4\u5230\u6B21\u6570\u7528\u5B8C\u6216\u65E0\u8DEF\u53EF\u8D70\u3002"
    Example: "\u5706\u5F62\u7EC8\u70B9 \xB7 \u6ED1\u884C\n\u91D1\u8272\u505C\u70B9
      \xB7 \u6025\u505C\n\n\u53F3\u952E / Esc \xB7 \u53D6\u6D88\u9884\u89C8"
  - Title: "\u751F\u547D\u4E0E\u8865\u5B50"
    Body: "\u6BCF\u65B9 5 \u70B9\u751F\u547D\uFF0C\u88AB\u5403\u4E00\u5B50\u6263
      1 \u70B9\uFF0C\u5F52\u96F6\u51FA\u5C40\u3002\n\n\u573A\u4E0A\u6700\u591A 8
      \u5B50\u3002\u9996\u6B21\u6ED1\u884C\u524D\u53EF\u70B9\u51FA\u751F\u683C +
      \u8865\u5B50\uFF0C\u4E0D\u6D88\u8017\u6ED1\u884C\u6B21\u6570\u3002\u88AB\u5403\u7684\u68CB\u5B50\u53EF\u4EE5\u518D\u6B21\u90E8\u7F72\u3002"
    Example: "\u751F\u547D 5 \u2192 4\n\n\u8865\u5B50\u4E0D\u6062\u590D\u751F\u547D\n\u53EA\u80FD\u901A\u8FC7\u5DF1\u65B9\u9635\u8425\u95E8"
  - Title: "\u4F20\u9001\u4E0E\u56F4\u6740"
    Body: "\u4F20\u9001\u843D\u5728\u914D\u5BF9\u95E8\u671D\u4E2D\u592E\u7684\u76F8\u90BB\u683C\uFF1B\u51FA\u53E3\u88AB\u5835\u65F6\u4E0D\u80FD\u901A\u8FC7\u3002\n\n\u540C\u8272\u68CB\u4E0A\u4E0B\u5DE6\u53F3\u8FDE\u6210\u68CB\u5757\uFF0C\u5171\u4EAB\u6C14\u3002\u4E24\u7AEF\u95E8\u53E3\u4E5F\u8FDE\u901A\u6C14\uFF1B\u5C01\u4F4F\u6700\u540E\u4E00\u53E3\u6C14\uFF0C\u53EF\u5728\u56DE\u5408\u672B\u56F4\u6740\u3002"
    Example: "\u672C\u6B21\u884C\u52A8\u4E0D\u81EA\u5403\n\n\u673A\u5173\u5899\u5728\u56DE\u5408\u672B\u5207\u6362\n\u5899\u53D8\u4E5F\u53EF\u80FD\u9020\u6210\u56F4\u6740"
  - Title: "\u9053\u5177"
    Body: "\u7A7F\u5899 \xB7 \u672C\u56DE\u5408\u7A7F\u8FC7\u673A\u5173\u5899\uFF0C\u5FFD\u7565\u4F20\u9001\u3002\n\n\u6025\u505C
      \xB7 \u4E0B\u4E00\u6B21\u6ED1\u884C\u9009\u62E9\u8DEF\u5F84\u505C\u70B9\u3002\n\n\u649E\u5403
      \xB7 \u672C\u56DE\u5408\u78B0\u5230\u654C\u68CB\u65F6\u5403\u6389\u5E76\u505C\u4E0B\u3002\n\n\u7834\u5899
      \xB7 \u672C\u56DE\u5408\u53EF\u505C\u5728\u673A\u5173\u5899\u4E0A\u3002"
    Example: "\u5148\u9009\u9053\u5177\uFF0C\u518D\u70B9\u76EE\u6807\n\n\u786E\u8BA4\u884C\u52A8\u624D\u6D88\u8017\n\u7834\u5899\u505C\u7559\u540E\uFF0C\u79BB\u5F00\u5373\u6062\u590D"
