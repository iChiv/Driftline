%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 50c43620e9e093a4cb1991cdc37cf5b0, type: 3}
  m_Name: RuleGuideContent
  m_EditorClassIdentifier: 
  Steps:
  - Title: "\u4ECE\u68CB\u76D8\u5F00\u59CB"
    Body: "\u70B9\u51FB\u9AB0\u5B50 \u2192 \u70B9\u51FB\u5DF1\u65B9\u68CB\u5B50 \u2192
      \u60AC\u505C\u7EC8\u70B9\u67E5\u770B\u884C\u52A8\u539F\u56E0 \u2192 \u70B9\u51FB\u7EC8\u70B9\u63D0\u4EA4\u3002\n\n\u70B9\u9009\u53EA\u662F\u9884\u89C8\uFF0C\u53EF\u4EE5\u6539\u9009\uFF1B\u53F3\u952E\u6216
      Esc \u53D6\u6D88\uFF0C\u4E0D\u6D88\u8017\u6B21\u6570\u6216\u9053\u5177\u3002\u9053\u5177\u53EF\u5728\u68CB\u5B50\u65C1\u9009\u62E9\uFF0C\u70B9\u76EE\u6807\u624D\u4E00\u8D77\u786E\u8BA4\u3002"
    Example: "\u63B7\u9AB0 \u2192 \u9009\u5B50 \u2192 \u770B\u9884\u89C8 \u2192 \u70B9\u7EC8\u70B9\n\n\u7EFF\u8272\uFF1A\u6ED1\u884C\u7EC8\u70B9\n\u91D1\u8272\uFF1A\u6025\u505C\u505C\u70B9\n\u51FA\u751F\u683C
      +\uFF1A\u8865\u5B50"
  - Title: "\u4E00\u6B21\u6ED1\u884C\u4E0D\u7B49\u4E8E\u4E00\u683C"
    Body: "\u9AB0\u5B50\u51B3\u5B9A\u6ED1\u884C\u6B21\u6570\u3002\u6BCF\u6B21\u6CBF\u4E00\u4E2A\u65B9\u5411\u6ED1\u5230\u963B\u6321\u524D\uFF0C\u7ECF\u8FC7\u591A\u5C11\u683C\u90FD\u53EA\u6D88\u8017\u4E00\u6B21\u3002\n\n\u9996\u6B21\u63D0\u4EA4\u6ED1\u884C\u540E\uFF0C\u672C\u56DE\u5408\u7EE7\u7EED\u64CD\u4F5C\u540C\u4E00\u679A\u68CB\u5B50\u3002\u7528\u5B8C\u6B21\u6570\u624D\u7ED3\u7B97\uFF1B\u9009\u4E2D\u68CB\u5B50\u6CA1\u6709\u5408\u6CD5\u65B9\u5411\u65F6\u63D0\u524D\u7ED3\u7B97\uFF0C\u5269\u4F59\u6B21\u6570\u4F5C\u5E9F\uFF0C\u4E0D\u4F1A\u56E0\u6B64\u6D88\u8017\u8FD9\u679A\u68CB\u5B50\u3002"
    Example: "\u9AB0\u5B50 3 = \u6700\u591A 3 \u6B21\u6ED1\u884C\n\n\u8D77\u70B9
      \u25CF \u2500\u2500\u2500\u2500\u2500\u2192 \u7EC8\u70B9 \u25CF\n\u8FD9\u4E00\u6574\u6761\u8DEF\u7EBF\u53EA\u7B97
      1 \u6B21\n\n\u8FD8\u6709\u6B21\u6570\uFF1A\u7EE7\u7EED\u79FB\u52A8\u540C\u4E00\u679A\u68CB\u5B50"
  - Title: "\u514D\u8D39\u8865\u5B50\u4E0E\u9635\u8425\u95E8"
    Body: "\u63B7\u9AB0\u540E\u3001\u9996\u6B21\u6ED1\u884C\u524D\uFF0C\u7A7A\u51FA\u751F\u683C\u53EF\u70B9
      + \u8865\u5145\u4E00\u679A\u50A8\u5907\u68CB\u3002\u65B0\u68CB\u8981\u6709\u5408\u6CD5\u6ED1\u884C\u65B9\u5411\u3002\u8865\u5B50\u4E0D\u82B1\u6ED1\u884C\u6B21\u6570\uFF0C\u4E5F\u4E0D\u5F3A\u5236\u79FB\u52A8\u65B0\u68CB\u3002\n\n\u6BCF\u65B9\u5171\u5341\u679A\u68CB\u5B50\uFF1B\u88AB\u5403\u540E\u8BA1\u5165\u6D88\u8017\u3002\u81EA\u5DF1\u7684\u9635\u8425\u95E8\u53EF\u901A\u8FC7\uFF0C\u5176\u4ED6\u65B9\u53CA\u672A\u53C2\u6218\u65B9\u7684\u95E8\u963B\u6321\u901A\u884C\u3002"
    Example: "\u50A8\u5907\u68CB \u2192 \u7A7A\u51FA\u751F\u683C +\n\u6ED1\u884C\u6B21\u6570\u4FDD\u6301\u4E0D\u53D8\n\n\u968F\u540E\u53EF\u9009\u65E7\u68CB\u6216\u65B0\u68CB\n\u9996\u6B21\u6ED1\u884C\u540E\uFF1A\u672C\u56DE\u5408\u4E0D\u518D\u8865\u5B50"
  - Title: "\u9053\u5177\u4E0E\u4F20\u9001"
    Body: "\u7A7F\u5899\uFF1A\u672C\u56DE\u5408\u7A7F\u8FC7\u5347\u8D77\u7684\u673A\u5173\u5899\uFF0C\u5E76\u5FFD\u7565\u4F20\u9001\u95E8\u3002\n\u6025\u505C\uFF1A\u4E0B\u4E00\u6B21\u6ED1\u884C\u70B9\u9009\u8DEF\u5F84\u505C\u70B9\uFF0C\u7528\u540E\u5931\u6548\u3002\n\u649E\u5403\uFF1A\u672C\u56DE\u5408\u63A5\u89E6\u654C\u68CB\u65F6\u5403\u6389\u5B83\u5E76\u505C\u4E0B\u3002\n\u7834\u5899\uFF1A\u672C\u56DE\u5408\u53EF\u505C\u5728\u673A\u5173\u5899\u6216\u4E2D\u5FC3\u5899\uFF0C\u79BB\u5F00\u540E\u6062\u590D\u3002\n\n\u666E\u901A\u6ED1\u884C\u8FDB\u5165\u4F20\u9001\u95E8\u540E\u4ECE\u914D\u5BF9\u95E8\u7EE7\u7EED\uFF1B\u6025\u505C\u524D\u540E\u7684\u5B9E\u9645\u843D\u70B9\u4EE5\u8DEF\u5F84\u9884\u89C8\u4E3A\u51C6\u3002"
    Example: "\u9009\u62E9\u9053\u5177 \u2260 \u6D88\u8017\u9053\u5177\n\u70B9\u76EE\u6807\u786E\u8BA4\u624D\u6D88\u8017\n\n\u5165\u53E3
      \u25C7 \u2026 \u914D\u5BF9\u51FA\u53E3 \u25C7\n\u4F20\u9001\u8DF3\u8DC3\u7684\u8DEF\u7EBF\u5206\u6BB5\u663E\u793A"
  - Title: "\u68CB\u5757\u4E0E\u751F\u8DEF"
    Body: "\u4E0A\u4E0B\u5DE6\u53F3\u76F8\u8FDE\u7684\u540C\u8272\u68CB\u7EC4\u6210\u68CB\u5757\uFF0C\u659C\u89D2\u4E0D\u8FDE\u63A5\u3002\u4E00\u5757\u68CB\u5171\u4EAB\u5468\u56F4\u7684\u6C14\uFF1A\u76F8\u90BB\u7A7A\u5730\u3001\u51FA\u751F\u683C\u6216\u964D\u4E0B\u7684\u673A\u5173\u69FD\u53EF\u63D0\u4F9B\u6C14\uFF1B\u5899\u3001\u95E8\u548C\u4F20\u9001\u95E8\u4E0D\u63D0\u4F9B\u6C14\u3002\n\n\u56DE\u5408\u672B\u5403\u6389\u7531\u672C\u56DE\u5408\u884C\u52A8\u9020\u6210\u7684\u65B0\u589E\u65E0\u6C14\u654C\u65B9\u68CB\u5757\u3002\u539F\u672C\u5DF2\u7ECF\u65E0\u6C14\u7684\u68CB\u5757\u4E0D\u56E0\u6B64\u91CD\u590D\u88AB\u5403\u3002\u5DF1\u65B9\u884C\u52A8\u4E0D\u4F1A\u76F4\u63A5\u5403\u6389\u81EA\u5DF1\u7684\u68CB\u5757\uFF0C\u8FD9\u5C31\u662F\u7981\u6B62\u81EA\u5403\u3002"
    Example: "\u25A0 \u5899   \u25CB \u7A7A\u5730   \u25CF \u540C\u8272\u68CB\n\n\u25A0 
      \u25A0  \u25A0\n\u25A0  \u25CF  \u25CB \u2190 \u8FD9\u4E00\u683C\u63D0\u4F9B\u6C14\n\u25A0 
      \u25A0  \u25A0\n\n\u5C01\u4F4F\u6700\u540E\u7684 \u25CB\uFF0C\u5C31\u53EF\u80FD\u5F62\u6210\u56F4\u6740"
  - Title: "\u673A\u5173\u5899\u5728\u56DE\u5408\u672B\u53D8\u5316"
    Body: "\u7ED3\u7B97\u987A\u5E8F\uFF1A\u5148\u68C0\u67E5\u5F53\u524D\u65B9\u4E94\u8FDE
      \u2192 \u65B0\u589E\u654C\u65B9\u56F4\u6740 \u2192 \u673A\u5173\u5899\u5207\u6362
      \u2192 \u5899\u53D8\u5316\u9020\u6210\u7684\u65B0\u65E0\u6C14 \u2192 \u6362\u4EBA\u3002\n\n\u5899\u53D8\u5316\u53EF\u5403\u6389\u4EFB\u4E00\u65B9\u3002\u5B83\u4E0D\u662F\u76F4\u63A5\u538B\u6B7B\u7AD9\u5728\u5899\u69FD\u4E0A\u7684\u68CB\u5B50\uFF1A\u68CB\u5B50\u5360\u636E\u7684\u69FD\u4F1A\u6291\u5236\u5899\u5347\u8D77\uFF1B\u5173\u952E\u662F\u5207\u6362\u540E\u68CB\u5757\u662F\u5426\u5931\u53BB\u6700\u540E\u7684\u6C14\u3002\u7EA2\u8272\u5371\u9669\u8109\u51B2\u63D0\u793A\u5899\u53D8\u5316\u98CE\u9669\u3002"
    Example: "\u5207\u6362\u524D\uFF1A\u25CF \u2500 \u25CB \u69FD\u4F4D\uFF0C\u4ECD\u6709\u751F\u8DEF\n\u5207\u6362\u540E\uFF1A\u25CF
      \u2500 \u25A0 \u5347\u5899\uFF0C\u5931\u53BB\u751F\u8DEF\n\n\u60AC\u505C\u6700\u540E\u4E00\u6B65\uFF1A\u67E5\u770B\u7ED3\u7B97\u9884\u89C8\n\u5DF1\u65B9\u884C\u52A8\u4E0D\u81EA\u5403\uFF0C\u5899\u53D8\u5316\u4ECD\u53EF\u80FD\u5403\u5DF1\u65B9"
  - Title: "\u600E\u6837\u83B7\u80DC"
    Body: "\u56DE\u5408\u7ED3\u7B97\u65F6\uFF0C\u5F53\u524D\u65B9\u4E94\u679A\u68CB\u5B50\u5728\u6A2A\u3001\u7AD6\u6216\u659C\u7EBF\u4E0A\u8FDE\u7EED\u6392\u5217\uFF0C\u5F62\u6210\u4E94\u8FDE\u5373\u83B7\u80DC\uFF0C\u4F18\u5148\u4E8E\u540E\u9762\u7684\u5403\u5B50\u7ED3\u7B97\u3002\n\n\u4E00\u65B9\u7D2F\u8BA1\u6D88\u8017\u5341\u679A\u68CB\u5B50\u4F1A\u51FA\u5C40\uFF1B\u5269\u4E0B\u6700\u540E\u4E00\u65B9\u4E5F\u83B7\u80DC\u3002\u9635\u8425\u540D\u5B57\u4E0E\u6545\u4E8B\u53EA\u5F71\u54CD\u8868\u73B0\uFF0C\u5404\u65B9\u80FD\u529B\u548C\u57FA\u672C\u89C4\u5219\u76F8\u540C\u3002"
    Example: "\u25CF  \u25CF  \u25CF  \u25CF  \u25CF\n\u6A2A\u3001\u7AD6\u3001\u659C\u7684\u8FDE\u7EED\u4E94\u679A\n\n\u6216\u6210\u4E3A\u6700\u540E\u5B58\u6D3B\u7684\u4E00\u65B9\n\n\u70B9\u5173\u95ED\u5373\u53EF\u7EE7\u7EED\u5F53\u524D\u68CB\u5C40"
